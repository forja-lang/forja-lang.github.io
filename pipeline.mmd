%% ═══════════════════════════════════════════════════════════════
%%   DIAGRAMA 1: FLUJO PRINCIPAL (por crate)
%% ═══════════════════════════════════════════════════════════════

flowchart TD
    S(["`**código fuente .fa**`"])

    subgraph FRONT["FRONTEND"]
        SY(["`**forja-syntax**
            compiler/forja-syntax
            tokens · lexer · parser · AST`"])
        TY(["`**forja-types**
            compiler/forja-types
            tipos · préstamos · inferencia`"])
        HIR(["`**forja-hir**
            compiler/forja-hir
            DefId · módulos · desugar`"])
    end

    subgraph MEDIO["MEDIO"]
        IR(["`**forja-ir**
            compiler/forja-ir
            SSA · optimizador · registros`"])
        BC(["`**forja-bytecode**
            compiler/forja-bytecode
            opcodes · uops · contratos`"])
    end

    subgraph EJEC["EJECUCIÓN"]
        VM(["`**forja-vm**
            compiler/forja-vm
            ForjaFast · JIT tiered · PGO`"])
        RT(["`**forja-runtime**
            compiler/forja-runtime
            GC · heap · trait Host`"])
        NAT(["`**forja-native**
            compiler/forja-native
            crypto · red · sqlite · ffi`"])
    end

    S --> SY --> TY --> HIR --> IR --> BC --> VM
    VM --- RT
    VM --- NAT

    classDef source fill:#2d2d3d,stroke:#7c7c9e,color:#fff
    classDef front fill:#1a3a5c,stroke:#4a8ccf,color:#e0e0e0
    classDef medio fill:#3a2d5a,stroke:#8a5ac8,color:#e0e0e0
    classDef ejec fill:#3a1e3a,stroke:#c060c0,color:#e0e0e0

    class S source
    class SY,TY,HIR front
    class IR,BC medio
    class VM,RT,NAT ejec

%% ═══════════════════════════════════════════════════════════════
%%   DIAGRAMA 2: RUTAS POR COMANDO
%% ═══════════════════════════════════════════════════════════════

flowchart LR
    subgraph RUTAS["RUTAS POR COMANDO"]
        C1["`**forja ejecutar**`"] --> R1["forja-syntax → forja-types → forja-hir → forja-ir → forja-bytecode → **forja-vm**
        (motor: rapido | jit en forja.yaml)"]
        C2["`**forja compilar**`"] --> R2["... → forja-bytecode → **forja-driver (AOT + selfrun)** → ejecutable"]
        C3["`**forja compilar-asm**`"] --> R3["forja-syntax → forja-types → **src/compiler_asm.rs** → .s → gcc/cl.exe"]
        C4["`**forja transpilar**`"] --> R4["forja-syntax → forja-types → **src/transpiler.rs** → proyecto Rust"]
        C5["`**forja interactivo**`"] --> R5["fuente acumulado → forja-bytecode → **forja-vm (ForjaFast)**"]
        C6["`**forja formatear**`"] --> R6["forja-syntax → **forja-fmt**"]
        C7["`**forja lint**`"] --> R7["forja-syntax → **forja-lint** → diagnósticos"]
        C8["`**forja diagrama**`"] --> R8["forja-syntax → **src/diagrama.rs** → Mermaid (.mmd)"]
    end

    classDef cmd fill:#1a1a2e,stroke:#4a4a8f,color:#fff
    classDef ruta fill:#1e3a2e,stroke:#3aa060,color:#e0e0e0

    class C1,C2,C3,C4,C5,C6,C7,C8 cmd
    class R1,R2,R3,R4,R5,R6,R7,R8 ruta

%% ═══════════════════════════════════════════════════════════════
%%   DIAGRAMA 3: CRATES DEL WORKSPACE
%% ═══════════════════════════════════════════════════════════════

flowchart LR
    subgraph COMP["compiler/ (workspace)"]
        E["forja-span · forja-errors · forja-session"]
        F["forja-syntax · forja-types · forja-hir"]
        M["forja-ir · forja-bytecode · forja-driver"]
        X["forja-runtime · forja-native · forja-vm · forja-registry"]
        H["forja-fmt · forja-lint"]
    end
    subgraph TOOLS["herramientas"]
        T["src/tools: forja-cli · forja-repl · forja-lsp · forja-dap"]
    end
    subgraph LIBS["library/ (submódulos)"]
        L["std · gui · gui-core · gui-theme · gui-rt · rt · android · wasm · wasm-gui"]
    end
    E --> F --> M --> X
    H --> F
    T --> X
    L --> X

    classDef comp fill:#1e1e2e,stroke:#4a4a7f,color:#e0e0e0
    class COMP,TOOLS,LIBS comp
